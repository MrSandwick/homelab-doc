# Copy to .env and fill in real values. .env is gitignored and must never be committed.
# The placeholder tokens below (e.g. <SERVER_IP>) match what's used throughout the docs in this repo;
# the committed docs only ever show the tokens, never real values.

# --- Identity (shared by server/ and network/) ---
HOSTNAME=your-hostname
WORKER_HOSTNAME=your-worker-hostname
USERNAME=your-username

# ===================== server/ =====================

# --- Server addressing ---
SERVER_IP=192.168.x.x
GATEWAY_IP=192.168.x.1
SERVER_SUBNET=192.168.x.0/24
CLIENT_SUBNET=192.168.x.0/24
SERVER_MAC=xx:xx:xx:xx:xx:xx

# --- Worker node (second Kubernetes node) ---
WORKER_IP=192.168.x.x
WORKER_MAC=xx:xx:xx:xx:xx:xx

# --- GPU worker node (laptop) ---
GPU_HOSTNAME=your-gpu-hostname

# --- Throwaway Ansible test node (a personal machine on another VLAN, used only for the learning phase) ---
TEST_NODE_HOSTNAME=your-test-node-hostname
TEST_NODE_IP=192.168.x.x

# --- MetalLB address pool (outside the router's DHCP range) and the ingress address ---
METALLB_POOL_START=192.168.x.x
METALLB_POOL_END=192.168.x.x
INGRESS_IP=192.168.x.x

# --- Kubernetes join token (short-lived, ~24h) — regenerate rather than reuse:
#       kubeadm token create --print-join-command
JOIN_TOKEN=xxxxx.xxxxxxxxxxxxxxxx
CA_CERT_HASH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Public site (SRV-23 .. SRV-25) ---
# DOMAIN: the public domain; DOMAIN_SLUG: the same with dots turned into dashes (used in Secret and object names); PUBLIC_GW_IP: MetalLB address of the public Gateway (not the LAN one);
# ACME_EMAIL: Let's Encrypt expiry warnings (never commit the real one to a public repository);
# EXPORTER_SERVICE_IP: ClusterIP of the blackbox exporter Service
DOMAIN=example.com
DOMAIN_SLUG=example-com
PUBLIC_GW_IP=192.168.x.x
ACME_EMAIL=you@example.com
EXPORTER_SERVICE_IP=10.x.x.x

# ===================== network/ =====================

# --- Subnets (first three octets only; docs use them as <ADMIN_SUBNET>.240, <ADMIN_SUBNET>/24, etc.) ---
MGMT_SUBNET=192.168.x
USERS_SUBNET=192.168.x
ADMIN_SUBNET=192.168.x

# --- Device management IPs (VLAN 1 / native) ---
ISP_GATEWAY_IP=
ROUTER_MGMT_IP=
SWITCH_MGMT_IP=
AP_MGMT_IP=

# --- IDS alert triage (SRV-26, SRV-27) ---
# GPU_IP: LAN address of the GPU laptop node that runs Ollama and the daily report timer;
# PUBLIC_HOST_IP: LAN address of the internet-facing web host the IDS watches (not the WAN address below)
GPU_IP=192.168.x.x
PUBLIC_HOST_IP=192.168.x.x

# --- Public forwarding (NET-09) ---
# PUBLIC_IP: the ISP gateway's WAN address (dynamic); ER605_WAN_IP: the address the ISP gateway reserves for the ER605
PUBLIC_IP=
ER605_WAN_IP=

# --- Admin VLAN (20) ---
ADMIN_GATEWAY_IP=
ADMIN_HOST_IP=

# --- Switch port used for the router uplink trunk ---
SWITCH_UPLINK_PORT=

# --- RADIUS ---
ROUTER_RADIUS_SECRET=
AP_RADIUS_SECRET=
LOCALHOST_CLIENT_SECRET=
TEST_USER=
TEST_PASSWORD=

# --- Known device MAC addresses (RADIUS users) ---
ADMIN_LAPTOP_MAC=
ADMIN_PHONE_MAC=

